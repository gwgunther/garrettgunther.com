---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFloatingNav from '../components/SiteFloatingNav.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import ImageCarouselInit from '../components/ImageCarouselInit.astro';
import { loadProjects, projectYears } from '../utils/projects';

const projects = loadProjects();
const archiveYears = projectYears(projects);
const sorted = [...projects].sort(
  (a, b) => new Date(b.sortDate).getTime() - new Date(a.sortDate).getTime()
);

let prevYear: number | null = null;
const gridItems = sorted.map((p) => {
  const year = new Date(p.sortDate).getFullYear();
  const isFirstOfYear = year !== prevYear;
  prevYear = year;
  const anchorId = isFirstOfYear ? `y-${year}` : undefined;
  return { p, year, anchorId, isFirstOfYear, cardId: `work-${p.slug}` };
});

const sortedDates = sorted.map((p) => new Date(p.sortDate).getTime());
const newestDate = Math.max(...sortedDates);
const oldestDate = Math.min(...sortedDates);
const newestYear = new Date(newestDate).getFullYear();
const oldestYear = new Date(oldestDate).getFullYear();
const dateRange = Math.max(newestDate - oldestDate, 1);
const timelinePosition = (date: string) =>
  ((new Date(date).getTime() - oldestDate) / dateRange) * 100;
const clampPosition = (position: number) => Math.min(100, Math.max(0, position));

const timelinePosts = gridItems.map(({ p, cardId, year }) => ({
  cardId,
  title: p.title,
  year,
  position: clampPosition(timelinePosition(p.sortDate)),
}));

const timelineYears = Array.from(
  { length: newestYear - oldestYear + 1 },
  (_, i) => oldestYear + i
).map((year) => ({
  year,
  position:
    newestYear === oldestYear
      ? 0
      : clampPosition(((year - oldestYear) / (newestYear - oldestYear)) * 100),
}));

const pageDesc =
  'Complete portfolio — film, photography, and creative direction by Garrett Gunther.';
const FORCE_EAGER_VIDEO_SLUGS = new Set([
  'daniel-busser-pas-loue-ft-kenny-gnius',
  'maku-hq',
  'okay-so-picture-this',
]);
---

<BaseLayout
  title="All work — Garrett Gunther"
  description={pageDesc}
  canonicalPath="/all/"
  darkModeMeshBackground={true}
  meshStrongCursor={true}
  bodyClass="page-all"
>
  <SiteHeader currentView="all" />
  <main id="main" class="all-layout">
    <nav class="all-years wrap" aria-label="Project timeline">
      <div class="all-years__rail">
        <div class="all-years__line" aria-hidden="true"></div>
        <div
          class="all-years__cursor"
          role="slider"
          tabindex="0"
          aria-label="Timeline position"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="100"
        ></div>
        <ul class="all-years__ticks" aria-hidden="true">
          {
            timelineYears.map(({ year, position }) => (
              <li class="all-years__tick" style={`--timeline-x: ${position}%`}>
                <span class="all-years__tick-line"></span>
                <span class="all-years__label">{year}</span>
              </li>
            ))
          }
        </ul>
        <ul class="all-years__posts">
          {
            timelinePosts.map(({ cardId, title, year, position }) => (
              <li class="all-years__post" style={`--timeline-x: ${position}%`}>
                <a
                  class="all-years__post-marker"
                  href={`#${cardId}`}
                  data-card-id={cardId}
                  data-timeline-x={position}
                  aria-label={`Jump to ${title}, ${year}`}
                ></a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <section class="all-work-scroll" data-smooth-scroll-host>
      <div id="work" class="wrap all-work-grid">
        <div class="project-grid">
          {
            gridItems.map(({ p, year, anchorId, isFirstOfYear, cardId }, i) => {
            const hero = p.gallery[0];
            const cloudinaryPreviewVideoSrc = p.cloudinaryPreviewVideoUrl;
            const vimeoId = p.vimeo[0];
            const youtubeId = !vimeoId ? p.youtube[0] : undefined;
            const localVideo = p.localVideo;
            const hasVideo = Boolean(cloudinaryPreviewVideoSrc || localVideo || vimeoId || youtubeId);
            const hasPhotos = p.gallery.length > 0;
            const isImageOnly = !hasVideo && hasPhotos;
            const carouselImages = isImageOnly
              ? p.gallery.slice(0, Math.min(5, p.gallery.length))
              : [];
            const useImageCarousel = carouselImages.length >= 2;
            const workHref = `/work/${p.slug}/`;
            const eagerMedia = i < 3 || FORCE_EAGER_VIDEO_SLUGS.has(p.slug);
            const vimeoPreviewSrc = vimeoId
              ? `https://player.vimeo.com/video/${vimeoId}?background=1&autopause=1&muted=1&loop=1`
              : undefined;
            const youtubePreviewSrc = youtubeId
              ? `https://www.youtube.com/embed/${youtubeId}?autoplay=1&mute=1&controls=0&playsinline=1&loop=1&playlist=${youtubeId}`
              : undefined;

              return (
                <article
                  class:list={[
                    'project-card',
                    'project-card--grid',
                    { 'project-card--year-start': isFirstOfYear },
                  ]}
                  id={cardId}
                  data-card-id={cardId}
                >
                {
                  isFirstOfYear && (
                    <span class="project-year-marker" id={anchorId} aria-label={`${year} projects`}>
                      <span>{year}</span>
                    </span>
                  )
                }
                <a href={workHref} class="project-card__whole-link">
                {hasVideo ? (
                  <div
                    class:list={[
                      'project-card__thumb project-card__thumb--embed',
                      { 'project-card__thumb--cloudinary': Boolean(cloudinaryPreviewVideoSrc) },
                    ]}
                  >
                    {
                      cloudinaryPreviewVideoSrc ? (
                        <video
                          muted
                          loop
                          autoplay
                          playsinline
                          preload={eagerMedia ? 'metadata' : 'none'}
                          aria-label={`${p.title} preview`}
                          tabindex="-1"
                        >
                          <source src={cloudinaryPreviewVideoSrc} type="video/mp4" />
                        </video>
                      ) : localVideo ? (
                        <video
                          muted
                          loop
                          autoplay
                          playsinline
                          preload={eagerMedia ? 'metadata' : 'none'}
                          aria-label={`${p.title} preview`}
                          tabindex="-1"
                        >
                          <source src={localVideo} type="video/mp4" />
                        </video>
                      ) : vimeoId ? (
                        <iframe
                          title={`${p.title} preview`}
                          src={eagerMedia ? vimeoPreviewSrc : undefined}
                          data-embed-src={vimeoPreviewSrc}
                          allow="autoplay; fullscreen; picture-in-picture"
                          allowfullscreen
                          loading={eagerMedia ? 'eager' : 'lazy'}
                          tabindex="-1"
                        />
                      ) : youtubeId ? (
                        <div class="video-wrapper">
                          <iframe
                            class="youtube-preview-embed"
                            title={`${p.title} preview`}
                            src={eagerMedia ? youtubePreviewSrc : undefined}
                            data-embed-src={youtubePreviewSrc}
                            data-provider="youtube"
                            allow="autoplay; encrypted-media; picture-in-picture"
                            allowfullscreen
                            loading={eagerMedia ? 'eager' : 'lazy'}
                            tabindex="-1"
                          />
                          <div class="video-overlay" aria-hidden="true"></div>
                        </div>
                      ) : (
                        <span class="project-card__thumb-fallback" aria-hidden="true">
                          Film
                        </span>
                      )
                    }
                  </div>
                ) : useImageCarousel ? (
                  <div
                    class="project-card__thumb project-card__thumb--carousel"
                    data-image-carousel
                  >
                    {
                      carouselImages.map((filename, j) => (
                        <div
                          class="project-card__carousel-layer"
                          style={{
                            opacity: j === 0 ? 1 : 0,
                            zIndex: j === 0 ? 1 : 0,
                          }}
                          data-carousel-layer
                        >
                          <img
                            src={`/media/${p.slug}/${filename}`}
                            alt=""
                            loading={eagerMedia && j === 0 ? 'eager' : 'lazy'}
                            decoding="async"
                            width="640"
                            height="400"
                          />
                        </div>
                      ))
                    }
                  </div>
                ) : hero ? (
                  <div class="project-card__thumb">
                    <img
                      src={`/media/${p.slug}/${hero}`}
                      alt=""
                      loading={eagerMedia ? 'eager' : 'lazy'}
                      decoding="async"
                      width="640"
                      height="400"
                    />
                  </div>
                ) : (
                  <div class="project-card__thumb">
                    <span class="project-card__thumb-fallback" aria-hidden="true">
                      Project
                    </span>
                  </div>
                )}
                  <div class="project-card__grid-copy">
                    <div class="project-card__grid-title-row">
                      <h2 class="project-card__grid-title">{p.title}</h2>
                      {
                        (hasVideo || hasPhotos) && (
                          <span class="project-card__type-icons project-card__type-icons--grid" aria-hidden="true">
                            {
                              hasVideo ? (
                                <span class="project-card__type-icon" title="Includes film">
                                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <rect x="3" y="6" width="12.5" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                                    <path fill="currentColor" stroke="none" d="M18 9.5 22 12l-4 2.5V9.5Z" />
                                  </svg>
                                </span>
                              ) : null
                            }
                            {
                              hasPhotos ? (
                                <span class="project-card__type-icon" title="Includes photography">
                                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <rect x="3.25" y="5.25" width="17.5" height="13.5" rx="2" stroke="currentColor" stroke-width="1.5" />
                                    <circle cx="9" cy="10" r="1.5" fill="currentColor" stroke="none" />
                                    <path
                                      d="M3.5 17.5 8 12l3.5 3.5 3-3L20.5 18"
                                      stroke="currentColor"
                                      stroke-width="1.5"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>
                                </span>
                              ) : null
                            }
                          </span>
                        )
                      }
                    </div>
                    <p class="project-card__meta">
                      <span class="sr-only">{year}, </span>
                      {p.dateLabel}
                    </p>
                  </div>
                </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

  </main>

  <SiteFloatingNav
    items={[
      { label: 'Home', href: '/' },
      { label: 'All projects', href: '/all/', active: true },
    ]}
  />
  <SmoothScroll />
  <ImageCarouselInit />

  <script is:inline>
    if (typeof window !== 'undefined') {
      const scrollHost = document.querySelector('[data-smooth-scroll-host]');
      const rail = document.querySelector('.all-years__rail');
      const cursor = document.querySelector('.all-years__cursor');
      const topOffset = 12;
      const dragThresholdPx = 4;
      let isDraggingTimeline = false;
      let pendingDragPercent = null;
      let dragFrame = 0;
      let selectedCard = null;
      let pointerDownX = 0;
      let pointerMoved = false;
      let pinnedTimelinePercent = null;

      const markers = Array.from(
        document.querySelectorAll('.all-years__post-marker[data-card-id]')
      );

      const cards = markers
        .map((marker) => {
          const cardId = marker.dataset.cardId;
          const el = cardId ? document.getElementById(cardId) : null;
          return el ? { marker, el } : null;
        })
        .filter(Boolean);

      const timelineCards = [...cards].sort((a, b) => {
        return Number(a.marker.dataset.timelineX ?? 0) - Number(b.marker.dataset.timelineX ?? 0);
      });

      function clampPercent(percent) {
        return Math.min(100, Math.max(0, percent));
      }

      function percentFromPointer(clientX) {
        if (!rail) return 0;
        const rect = rail.getBoundingClientRect();
        if (!rect.width) return 0;
        return clampPercent(((clientX - rect.left) / rect.width) * 100);
      }

      function closestCardToPercent(percent) {
        return cards.reduce((closest, card) => {
          const cardPercent = Number(card.marker.dataset.timelineX ?? 0);
          const closestPercent = Number(closest.marker.dataset.timelineX ?? 0);
          return Math.abs(cardPercent - percent) < Math.abs(closestPercent - percent)
            ? card
            : closest;
        }, cards[0]);
      }

      function setActiveCard(active) {
        if (!active || !cursor) return;

        for (const { marker } of cards) {
          marker.classList.toggle('is-active', marker === active.marker);
        }

        const percent = active.marker.dataset.timelineX ?? 0;
        cursor.style.left = `${percent}%`;
        cursor.setAttribute('aria-valuenow', String(Math.round(Number(percent))));
      }

      function setSelectedCard(active) {
        selectedCard = active ?? null;

        for (const { marker } of cards) {
          marker.classList.toggle('is-selected', selectedCard?.marker === marker);
        }

        if (selectedCard) {
          setActiveCard(selectedCard);
        }
      }

      function getLenis() {
        return scrollHost && scrollHost.__ggLenis ? scrollHost.__ggLenis : null;
      }

      function scrollToCard(active, behavior, options = {}) {
        if (!active) return;
        if (!scrollHost) return;
        const alignTop = Boolean(options.alignTop);
        const lenis = getLenis();
        if (lenis) {
          lenis.scrollTo(active.el, {
            offset: alignTop ? 0 : -topOffset,
            immediate: behavior === 'auto',
          });
          return;
        }
        const hostRect = scrollHost.getBoundingClientRect();
        const cardRect = active.el.getBoundingClientRect();
        const cardTopWithinHost = scrollHost.scrollTop + (cardRect.top - hostRect.top);
        const top = Math.max(0, cardTopWithinHost - (alignTop ? 0 : topOffset));
        scrollHost.scrollTo({ top, behavior });
      }

      function dragToPercent(percent) {
        if (!cursor || !cards.length) return;
        const clamped = clampPercent(percent);
        cursor.style.left = `${clamped}%`;
        cursor.setAttribute('aria-valuenow', String(Math.round(clamped)));

        if (!scrollHost) return;
        const maxScroll = Math.max(scrollHost.scrollHeight - scrollHost.clientHeight, 0);
        const targetTop = ((100 - clamped) / 100) * maxScroll;
        const lenis = getLenis();
        if (lenis) {
          lenis.scrollTo(targetTop, { immediate: true });
        } else {
          scrollHost.scrollTo({ top: targetTop, behavior: 'auto' });
        }
      }

      function setActivePost() {
        if (!cards.length || !cursor || isDraggingTimeline) return;
        if (!scrollHost) return;
        if (pinnedTimelinePercent !== null) {
          cursor.style.left = `${pinnedTimelinePercent}%`;
          cursor.setAttribute('aria-valuenow', String(Math.round(pinnedTimelinePercent)));
          return;
        }
        if (selectedCard) {
          setActiveCard(selectedCard);
          return;
        }
        const hostRect = scrollHost.getBoundingClientRect();
        const viewportBottom = hostRect.bottom;
        const viewportTop = hostRect.top;
        const visibleCards = cards
          .map((card) => ({
            ...card,
            rect: card.el.getBoundingClientRect(),
          }))
          .filter(({ rect }) => rect.bottom > viewportTop && rect.top < viewportBottom)
          .sort((a, b) => {
            const rowDelta = Math.abs(a.rect.top - b.rect.top);
            if (rowDelta > 8) return a.rect.top - b.rect.top;
            return a.rect.left - b.rect.left;
          });

        const active = visibleCards[0] ?? cards[0];

        setActiveCard(active);
      }

      function flushDragFrame() {
        dragFrame = 0;
        if (pendingDragPercent === null) return;
        dragToPercent(pendingDragPercent);
      }

      if (rail && cursor) {
        rail.addEventListener('pointerdown', (event) => {
          if (!cards.length) return;
          const target = event.target;
          if (target instanceof Element && target.closest('.all-years__post-marker')) {
            // Hash marker clicks are handled by their own click listener.
            return;
          }
          event.preventDefault();
          pinnedTimelinePercent = null;
          isDraggingTimeline = true;
          pointerDownX = event.clientX;
          pointerMoved = false;
          rail.setPointerCapture(event.pointerId);
        });

        rail.addEventListener('pointermove', (event) => {
          if (!isDraggingTimeline) return;
          if (!pointerMoved && Math.abs(event.clientX - pointerDownX) >= dragThresholdPx) {
            pointerMoved = true;
          }
          if (!pointerMoved) return;
          pendingDragPercent = percentFromPointer(event.clientX);
          if (!dragFrame) {
            dragFrame = window.requestAnimationFrame(flushDragFrame);
          }
        });

        rail.addEventListener('pointerup', (event) => {
          if (!isDraggingTimeline) return;
          isDraggingTimeline = false;
          const targetPercent = pointerMoved
            ? pendingDragPercent
            : percentFromPointer(event.clientX);
          if (targetPercent !== null) {
            if (pointerMoved) {
              // Keep exact dropped position after a drag; do not snap to nearest card.
              setSelectedCard(null);
              pinnedTimelinePercent = clampPercent(targetPercent);
              dragToPercent(targetPercent);
            } else {
              pinnedTimelinePercent = null;
              const active = closestCardToPercent(targetPercent);
              setSelectedCard(active);
              scrollToCard(active, 'smooth', { alignTop: true });
            }
          }
          pendingDragPercent = null;
          pointerMoved = false;
          rail.releasePointerCapture(event.pointerId);
        });

        rail.addEventListener('pointercancel', (event) => {
          isDraggingTimeline = false;
          pendingDragPercent = null;
          pointerMoved = false;
          rail.releasePointerCapture(event.pointerId);
        });

        cursor.addEventListener('keydown', (event) => {
          if (!cards.length || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
          event.preventDefault();

          const activeIndex = timelineCards.findIndex(({ marker }) => marker.classList.contains('is-active'));
          const fallbackIndex = activeIndex === -1 ? 0 : activeIndex;
          const nextIndex = event.key === 'ArrowRight'
            ? Math.min(timelineCards.length - 1, fallbackIndex + 1)
            : Math.max(0, fallbackIndex - 1);
          const active = timelineCards[nextIndex];

          pinnedTimelinePercent = null;
          setActiveCard(active);
          setSelectedCard(active);
          scrollToCard(active, 'smooth', { alignTop: true });
        });

        markers.forEach((marker) => {
          marker.addEventListener('click', (event) => {
            event.preventDefault();
            pinnedTimelinePercent = null;
            const active = cards.find((card) => card.marker === marker);
            if (!active) return;
            setSelectedCard(active);
            scrollToCard(active, 'smooth', { alignTop: true });
          });
        });
      }

      if (scrollHost) {
        scrollHost.addEventListener('scroll', setActivePost, { passive: true });
        scrollHost.addEventListener('wheel', () => {
          pinnedTimelinePercent = null;
        }, { passive: true });
        scrollHost.addEventListener('touchstart', () => {
          pinnedTimelinePercent = null;
        }, { passive: true });
        scrollHost.addEventListener('pointerdown', () => {
          pinnedTimelinePercent = null;
        }, { passive: true });
      }
      window.addEventListener('resize', setActivePost);
      setActivePost();

      // Lazy-load offscreen iframe previews so above-the-fold cards load first.
      const lazyEmbeds = Array.from(document.querySelectorAll('iframe[data-embed-src]:not([src])'));
      if (lazyEmbeds.length) {
        const loadEmbed = (iframe) => {
          const embedSrc = iframe.dataset.embedSrc;
          if (embedSrc && !iframe.getAttribute('src')) {
            iframe.setAttribute('src', embedSrc);
          }
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const iframe = entry.target;
                loadEmbed(iframe);
                observer.unobserve(iframe);
              }
            },
            { rootMargin: '240px 0px' }
          );

          for (const iframe of lazyEmbeds) {
            observer.observe(iframe);
          }
        } else {
          for (const iframe of lazyEmbeds) {
            loadEmbed(iframe);
          }
        }
      }

    }
  </script>

  <style>
    .video-wrapper {
      position: absolute;
      inset: 0;
    }

    .video-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    /* Aggressive YouTube-only overscan to push left-edge seam off-canvas. */
    .youtube-preview-embed {
      right: auto;
      top: -1px;
      left: -6px;
      width: calc(100% + 12px);
      height: calc(100% + 2px);
      clip-path: inset(1px 0 1px 6px);
    }
  </style>
</BaseLayout>
