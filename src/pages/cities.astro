---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout
  title="Cities"
  description="Interactive cities fluid study."
  canonicalPath="/cities/"
  darkModeMeshBackground={true}
  bodyClass="page-cities"
>
  <SiteHeader />
  <main id="main" class="cities-page">
    <iframe
      class="cities-frame"
      src="/cities.html"
      title="Cities fluid study"
      loading="eager"
      referrerpolicy="no-referrer"
    ></iframe>
  </main>
</BaseLayout>

<style is:global>
  /* Fill whatever height the header leaves, rather than subtracting a
     hardcoded header height that the title size would invalidate. */
  body.page-cities {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .cities-page {
    flex: 1;
    display: flex;
    min-height: 0;
    margin: 0;
    padding-inline: var(--space-md);
    padding-bottom: var(--space-lg);
  }

  .cities-frame {
    flex: 1;
    width: 100%;
    min-height: 0;
    border: 0;
    background: transparent;
  }
</style>
