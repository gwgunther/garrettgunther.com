---
/** Minimal home footer — social only */
const social = [
  { label: 'Instagram', href: 'https://instagram.com/gwgunther' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/garrett-gunther-55b1a624/' },
];
---

<footer class="home-site-footer">
  <ul class="home-site-footer__social">
    {
      social.map((item) => (
        <li>
          <a
            class="home-site-footer__link link-animated-underline"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.label} ↗
          </a>
        </li>
      ))
    }
  </ul>
</footer>
