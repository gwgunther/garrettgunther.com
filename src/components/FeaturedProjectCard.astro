---
import type { Project } from '../utils/projects';

type Props = {
  project: Project;
  /** Eager-load embeds for first items above the fold */
  isPriority: boolean;
  animationIndex: number;
};

const { project: p, isPriority, animationIndex } = Astro.props;

const hero = p.gallery[0];
const localVideo = p.localVideo;
const cloudinaryPreviewVideoSrc = p.cloudinaryPreviewVideoUrl;
const cloudinaryEmbedUrl = p.cloudinaryEmbedUrl;
const vimeoId = p.vimeo[0];
const youtubeId = !vimeoId ? p.youtube[0] : undefined;
const youtubeDesktopEmbedUrl = youtubeId
  ? `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=0&mute=0&playsinline=1&controls=1&rel=0&modestbranding=1&loop=0&iv_load_policy=3&cc_load_policy=0&fs=0`
  : undefined;
const hasVideo = Boolean(cloudinaryPreviewVideoSrc || localVideo || vimeoId || youtubeId);
const hasPhotos = p.gallery.length > 0;
const isEmbed = Boolean(cloudinaryPreviewVideoSrc || localVideo || vimeoId || youtubeId);
---

<article
  class="project-card project-card--grid project-card--home"
  style={{ animationDelay: `${Math.min(animationIndex, 8) * 0.04}s` }}
>
  <div
    class:list={[
      'project-card__thumb project-card__thumb-link',
      {
        'project-card__thumb--embed': isEmbed,
        'project-card__thumb--cloudinary': Boolean(cloudinaryPreviewVideoSrc),
      },
    ]}
  >
    {
      cloudinaryEmbedUrl && cloudinaryPreviewVideoSrc ? (
        <>
          <video
            class="project-card__home-cloudinary-desktop"
            controls
            playsinline
            preload={isPriority ? 'metadata' : 'none'}
            aria-label={`${p.title} — film`}
            data-home-inline-video
          >
            <source src={cloudinaryPreviewVideoSrc} type="video/mp4" />
          </video>
          <video
            class="project-card__home-cloudinary-mobile"
            data-mobile-autoplay-preview
            muted
            loop
            autoplay
            playsinline
            preload={isPriority ? 'metadata' : 'none'}
            aria-label={`${p.title} preview`}
          >
            <source src={cloudinaryPreviewVideoSrc} type="video/mp4" />
          </video>
        </>
      ) : localVideo ? (
        <video
          controls
          playsinline
          preload={isPriority ? 'metadata' : 'none'}
          aria-label={`${p.title} — film`}
          data-home-inline-video
        >
          <source src={localVideo} type="video/mp4" />
        </video>
      ) : vimeoId ? (
        <iframe
          title={`${p.title} — film`}
          src={`https://player.vimeo.com/video/${vimeoId}`}
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          loading={isPriority ? 'eager' : 'lazy'}
        />
      ) : youtubeId ? (
        <iframe
          title={`${p.title} — film`}
          src={youtubeDesktopEmbedUrl}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading={isPriority ? 'eager' : 'lazy'}
        />
      ) : hero ? (
        <img
          src={`/media/${p.slug}/${hero}`}
          alt=""
          loading={isPriority ? 'eager' : 'lazy'}
          fetchpriority={isPriority ? 'high' : undefined}
          decoding="async"
          width="1200"
          height="900"
        />
      ) : (
        <span class="project-card__thumb-fallback" aria-hidden="true">
          View project
        </span>
      )
    }
  </div>
  <a href={`/work/${p.slug}/`} class="project-card__grid-link">
    <div class="project-card__grid-copy">
      <div class="project-card__grid-title-row">
        <h2 class="project-card__grid-title">{p.title}</h2>
      {
        (hasVideo || hasPhotos) && (
          <span class="project-card__type-icons project-card__type-icons--grid" aria-label={`${p.title} media types`}>
            {
              hasVideo ? (
                <span class="project-card__type-icon" title="Includes film">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="6" width="12.5" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                    <path fill="currentColor" stroke="none" d="M18 9.5 22 12l-4 2.5V9.5Z" />
                  </svg>
                </span>
              ) : null
            }
            {
              hasPhotos ? (
                <span class="project-card__type-icon" title="Includes photography">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3.25" y="5.25" width="17.5" height="13.5" rx="2" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="9" cy="10" r="1.5" fill="currentColor" stroke="none" />
                    <path
                      d="M3.5 17.5 8 12l3.5 3.5 3-3L20.5 18"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              ) : null
            }
          </span>
        )
      }
      </div>
      <p class="project-card__meta">
        {p.dateLabel}
        {
          p.location ? (
            <>
              <span class="sr-only">, </span>
              <span aria-hidden="true"> | </span>
              {p.location}
            </>
          ) : null
        }
      </p>
    </div>
  </a>
</article>

<script>
  if (typeof window !== 'undefined') {
    // Only add the click-to-play shortcut on mouse devices; on touch devices
    // the native controls handle play/pause and this handler fights them.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const inlineVideos = Array.from(document.querySelectorAll('video[data-home-inline-video]'));
      for (const video of inlineVideos) {
        video.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('video')) return;
          if (video.paused) {
            video.play().catch(() => {});
          }
        });
      }
    }

    const previews = Array.from(document.querySelectorAll('video[data-mobile-autoplay-preview]'));
    for (const preview of previews) {
      preview.addEventListener('click', () => {
        const thumb = preview.closest('.project-card__thumb');
        const desktop = thumb?.querySelector('.project-card__home-cloudinary-desktop');
        if (desktop instanceof HTMLVideoElement) {
          preview.style.display = 'none';
          desktop.style.display = 'block';
          desktop.play().catch(() => {});
        }
      });
    }
  }
</script>

<style>
  .project-card__home-cloudinary-mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .project-card__home-cloudinary-desktop {
      display: none;
    }

    .project-card__home-cloudinary-mobile {
      display: block;
    }
  }
</style>
