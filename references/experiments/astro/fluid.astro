---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FluidMarbleFull from '../components/FluidMarbleFull.astro';
---

<BaseLayout
  title="Fluid"
  description="Interactive fluid gradient texture."
  canonicalPath="/fluid/"
>
  <SiteHeader currentView="fluid" />
  <main id="main" class="fluid-page">
    <div class="fluid-host" data-flow aria-hidden="true"></div>
  </main>
  <FluidMarbleFull />
</BaseLayout>

<style is:global>
  .fluid-page {
    margin: 0;
    padding: 0;
    min-height: 100dvh;
  }

  .fluid-host {
    position: fixed;
    inset: 0;
    z-index: 0;
    cursor: crosshair;
    isolation: isolate;
  }

  .fluid-host canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0;
    transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fluid-host canvas.ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .fluid-host canvas {
      display: none;
    }

    .fluid-host {
      background: linear-gradient(135deg, #0a1530, #1a2e60);
    }
  }
</style>
