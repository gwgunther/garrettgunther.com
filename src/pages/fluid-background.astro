---
import FluidMarbleFull from '../components/FluidMarbleFull.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fluid Background</title>
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #0a1530;
      }

      .fluid-host {
        position: fixed;
        inset: 0;
        cursor: crosshair;
        isolation: isolate;
      }

      .fluid-host canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .fluid-host canvas.ready {
        opacity: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        .fluid-host canvas {
          display: none;
        }

        .fluid-host {
          background: linear-gradient(135deg, #0a1530, #1a2e60);
        }
      }
    </style>
  </head>
  <body>
    <div class="fluid-host" data-flow aria-hidden="true"></div>
    <FluidMarbleFull />
  </body>
</html>
