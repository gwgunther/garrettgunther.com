---
import type { Project } from '../utils/projects';

type Props = {
  project: Project;
  /** Eager-load embeds for first items above the fold */
  isPriority: boolean;
  animationIndex: number;
};

const { project: p, isPriority, animationIndex } = Astro.props;

const hero = p.gallery[0];
const localVideo = p.localVideo;
const cloudinaryPreviewVideoSrc = p.cloudinaryPreviewVideoUrl;
const cloudinaryEmbedUrl = p.cloudinaryEmbedUrl;
const vimeoId = p.vimeo[0];
const youtubeId = !vimeoId ? p.youtube[0] : undefined;
const youtubeDesktopEmbedUrl = youtubeId
  ? `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=0&mute=0&playsinline=1&controls=1&rel=0&modestbranding=1&loop=0&iv_load_policy=3&cc_load_policy=0&fs=0`
  : undefined;
const youtubeMobileRealUrl = youtubeId
  ? `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&mute=0&playsinline=1&controls=1&rel=0&modestbranding=1&loop=0&iv_load_policy=3&cc_load_policy=0&fs=0`
  : undefined;
const vimeoMobilePreviewUrl = vimeoId
  ? `https://player.vimeo.com/video/${vimeoId}?background=1&autoplay=1&autopause=0&muted=1&api=1`
  : undefined;
const vimeoMobileRealUrl = vimeoId
  ? `https://player.vimeo.com/video/${vimeoId}?autoplay=1`
  : undefined;
const thumbnailUrl = vimeoId
  ? `https://vumbnail.com/${vimeoId}.jpg`
  : youtubeId
  ? `https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`
  : undefined;
const hasVideo = Boolean(cloudinaryPreviewVideoSrc || localVideo || vimeoId || youtubeId);
const hasPhotos = p.gallery.length > 0;
const isEmbed = Boolean(cloudinaryPreviewVideoSrc || localVideo || vimeoId || youtubeId);
---

<article
  class="project-card project-card--grid project-card--home"
  style={{ animationDelay: `${Math.min(animationIndex, 8) * 0.04}s` }}
>
  <div
    class:list={[
      'project-card__thumb project-card__thumb-link',
      {
        'project-card__thumb--embed': isEmbed,
        'project-card__thumb--cloudinary': Boolean(cloudinaryPreviewVideoSrc),
      },
    ]}
  >
    {
      cloudinaryEmbedUrl && cloudinaryPreviewVideoSrc ? (
        <>
          <video
            class="project-card__home-cloudinary-desktop"
            controls
            playsinline
            preload={isPriority ? 'metadata' : 'none'}
            aria-label={`${p.title} — film`}
            data-home-inline-video
          >
            <source src={cloudinaryPreviewVideoSrc} type="video/mp4" />
          </video>
          <video
            class="project-card__home-cloudinary-mobile"
            data-mobile-autoplay-preview
            muted
            loop
            autoplay
            playsinline
            preload={isPriority ? 'metadata' : 'none'}
            aria-label={`${p.title} preview`}
          >
            <source src={cloudinaryPreviewVideoSrc} type="video/mp4" />
          </video>
        </>
      ) : localVideo ? (
        <video
          controls
          playsinline
          preload={isPriority ? 'metadata' : 'none'}
          aria-label={`${p.title} — film`}
          data-home-inline-video
        >
          <source src={localVideo} type="video/mp4" />
        </video>
      ) : vimeoId ? (
        <>
          <iframe
            class="project-card__embed-desktop"
            title={`${p.title} — film`}
            src={`https://player.vimeo.com/video/${vimeoId}`}
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading={isPriority ? 'eager' : 'lazy'}
          />
          <iframe
            class="project-card__embed-mobile"
            title={`${p.title} preview`}
            src={vimeoMobilePreviewUrl}
            allow="autoplay; fullscreen; picture-in-picture"
            loading={isPriority ? 'eager' : 'lazy'}
          />
          {thumbnailUrl && (
            <img
              class="project-card__embed-thumbnail"
              src={thumbnailUrl}
              alt=""
              aria-hidden="true"
              loading={isPriority ? 'eager' : 'lazy'}
              decoding="async"
            />
          )}
          <div
            class="project-card__mobile-tap-overlay"
            aria-hidden="true"
            data-real-src={vimeoMobileRealUrl}
          />
        </>
      ) : youtubeId ? (
        <>
          <iframe
            class="project-card__embed-desktop"
            title={`${p.title} — film`}
            src={youtubeDesktopEmbedUrl}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading={isPriority ? 'eager' : 'lazy'}
          />
          <iframe
            class="project-card__embed-mobile"
            title={`${p.title} preview`}
            src={`https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&mute=1&controls=0&playsinline=1&loop=1&playlist=${youtubeId}&enablejsapi=1`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            loading={isPriority ? 'eager' : 'lazy'}
          />
          {thumbnailUrl && (
            <img
              class="project-card__embed-thumbnail"
              src={thumbnailUrl}
              alt=""
              aria-hidden="true"
              loading={isPriority ? 'eager' : 'lazy'}
              decoding="async"
            />
          )}
          <div
            class="project-card__mobile-tap-overlay"
            aria-hidden="true"
            data-real-src={youtubeMobileRealUrl}
          />
        </>
      ) : hero ? (
        <img
          src={`/media/${p.slug}/${hero}`}
          alt=""
          loading={isPriority ? 'eager' : 'lazy'}
          fetchpriority={isPriority ? 'high' : undefined}
          decoding="async"
          width="1200"
          height="900"
        />
      ) : (
        <span class="project-card__thumb-fallback" aria-hidden="true">
          View project
        </span>
      )
    }
  </div>
  <a href={`/work/${p.slug}/`} class="project-card__grid-link">
    <div class="project-card__grid-copy">
      <div class="project-card__grid-title-row">
        <h2 class="project-card__grid-title">{p.title}</h2>
      {
        (hasVideo || hasPhotos) && (
          <span class="project-card__type-icons project-card__type-icons--grid" aria-label={`${p.title} media types`}>
            {
              hasVideo ? (
                <span class="project-card__type-icon" title="Includes film">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="6" width="12.5" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                    <path fill="currentColor" stroke="none" d="M18 9.5 22 12l-4 2.5V9.5Z" />
                  </svg>
                </span>
              ) : null
            }
            {
              hasPhotos ? (
                <span class="project-card__type-icon" title="Includes photography">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3.25" y="5.25" width="17.5" height="13.5" rx="2" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="9" cy="10" r="1.5" fill="currentColor" stroke="none" />
                    <path
                      d="M3.5 17.5 8 12l3.5 3.5 3-3L20.5 18"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              ) : null
            }
          </span>
        )
      }
      </div>
      <p class="project-card__meta">
        {p.dateLabel}
        {
          p.location ? (
            <>
              <span class="sr-only">, </span>
              <span aria-hidden="true"> | </span>
              {p.location}
            </>
          ) : null
        }
      </p>
    </div>
  </a>
</article>

<script>
  if (typeof window !== 'undefined') {
    // Only add the click-to-play shortcut on mouse devices; on touch devices
    // the native controls handle play/pause and this handler fights them.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const inlineVideos = Array.from(document.querySelectorAll('video[data-home-inline-video]'));
      for (const video of inlineVideos) {
        video.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('video')) return;
          if (video.paused) {
            video.play().catch(() => {});
          }
        });
      }
    }

    const previews = Array.from(document.querySelectorAll('video[data-mobile-autoplay-preview]'));
    for (const preview of previews) {
      preview.addEventListener('click', () => {
        // Mutate in-place: the video is already buffered and playing, so
        // unmuting/adding controls/seeking is instant with no reload.
        preview.muted = false;
        preview.loop = false;
        preview.controls = true;
        preview.currentTime = 0;
        preview.play().catch(() => {});
      });
    }

    const hideThumbnail = (thumbnail: HTMLElement) => {
      thumbnail.style.opacity = '0';
    };

    // Build a map of iframe contentWindow → thumbnail so we can match
    // postMessage events (which carry e.source) to the right card.
    const mobileIframes = Array.from(document.querySelectorAll<HTMLIFrameElement>('.project-card__embed-mobile'));
    const iframeToThumbnail = new Map<Window, HTMLElement>();
    for (const iframe of mobileIframes) {
      const thumbnail = iframe.closest('.project-card__thumb')
        ?.querySelector<HTMLElement>('.project-card__embed-thumbnail');
      if (!thumbnail) continue;
      if (iframe.contentWindow) {
        iframeToThumbnail.set(iframe.contentWindow, thumbnail);
      }
      // Fallback: fade 3s after the player HTML loads in case postMessage never arrives
      // (e.g. iOS where cross-frame events can be unreliable).
      iframe.addEventListener('load', () => {
        window.setTimeout(() => hideThumbnail(thumbnail), 3000);
      });
    }

    // Vimeo requires explicit event subscription after the player signals ready.
    // YouTube with enablejsapi=1 sends onStateChange automatically.
    window.addEventListener('message', (e) => {
      if (!e.source) return;
      const thumbnail = iframeToThumbnail.get(e.source as Window);
      if (!thumbnail) return;
      try {
        const data = JSON.parse(typeof e.data === 'string' ? e.data : JSON.stringify(e.data));
        // Subscribe to Vimeo playProgress once the player is ready.
        if (data.event === 'ready') {
          (e.source as Window).postMessage(
            JSON.stringify({ method: 'addEventListener', value: 'playProgress' }),
            '*'
          );
        }
        const isPlaying =
          data.event === 'playProgress' ||
          data.event === 'play' ||
          (data.event === 'onStateChange' && data.info === 1) ||
          (data.event === 'infoDelivery' && (data.info as any)?.playerState === 1);
        if (isPlaying) hideThumbnail(thumbnail);
      } catch {}
    });

    // Tap-to-activate for Vimeo/YouTube mobile previews.
    // The overlay captures the first tap, swaps the iframe to the real (controls)
    // src, then removes itself so the player is fully interactive.
    const tapOverlays = Array.from(document.querySelectorAll('.project-card__mobile-tap-overlay'));
    for (const overlay of tapOverlays) {
      overlay.addEventListener('click', () => {
        const thumb = overlay.closest('.project-card__thumb');
        const iframe = thumb?.querySelector('.project-card__embed-mobile');
        const thumbnail = thumb?.querySelector<HTMLElement>('.project-card__embed-thumbnail');
        if (thumbnail) hideThumbnail(thumbnail);
        if (iframe instanceof HTMLIFrameElement) {
          const realSrc = (overlay as HTMLElement).dataset.realSrc;
          if (realSrc) {
            iframe.src = realSrc;
            iframe.dataset.activated = '1';
          }
        }
        (overlay as HTMLElement).style.display = 'none';
      });
    }
  }
</script>

<style>
  .project-card__home-cloudinary-mobile {
    display: none;
  }

  .project-card__embed-mobile,
  .project-card__embed-thumbnail,
  .project-card__mobile-tap-overlay {
    display: none;
  }

  .project-card__embed-thumbnail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .project-card__home-cloudinary-desktop {
      display: none;
    }

    .project-card__home-cloudinary-mobile {
      display: block;
    }

    .project-card__embed-desktop {
      display: none;
    }

    .project-card__embed-mobile {
      display: block;
    }

    .project-card__embed-thumbnail {
      display: block;
    }

    .project-card__mobile-tap-overlay {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: auto;
    }

    .project-card__thumb--embed iframe[data-activated] {
      pointer-events: auto;
    }
  }
</style>
